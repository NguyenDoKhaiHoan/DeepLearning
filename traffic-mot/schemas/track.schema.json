{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traffic MOT track record v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "camera_id", "session_id", "frame_id", "track_id", "class_id", "class_name", "bbox", "confidence", "track_state", "observed", "timestamp_ms", "time_basis", "video_source"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "camera_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 1},
    "track_id": {"type": "integer", "minimum": 1},
    "class_id": {"enum": [3, 4, 5, 6, 7, 8, 9, 10]},
    "class_name": {"enum": ["bicycle", "car", "van", "truck", "tricycle", "awning-tricycle", "bus", "motor"]},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "track_state": {"enum": ["tentative", "tracked", "lost", "removed"]},
    "observed": {"type": "boolean"},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "time_basis": {"enum": ["media_pts", "frame_fps", "monotonic_session"]},
    "video_source": {"type": "string", "minLength": 1},
    "occlusion_state": {"enum": ["visible", "suspected_occluded", "suspected_exit", "unknown"]},
    "recovered": {"type": "boolean"}
  }
}
